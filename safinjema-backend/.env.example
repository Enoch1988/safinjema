# ─────────────────────────────────────────
#  SaFi Njema Backend – Environment Config
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=production

# JWT Secret  (use a long random string in production)
JWT_SECRET=change_this_to_a_very_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=7d

# Email (SMTP) – use Gmail, Outlook, or any SMTP provider
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=safinjema@outlook.com
SMTP_PASS=your_email_password_here

# Notification recipients
ADMIN_EMAIL=safinjema@outlook.com
ADMIN_PHONE=27713599995

# WhatsApp (optional – Twilio or CallMeBot)
# TWILIO_SID=your_twilio_sid
# TWILIO_TOKEN=your_twilio_token
# TWILIO_WA_FROM=whatsapp:+14155238886

# Frontend origin for CORS
FRONTEND_ORIGIN=https://safinjema.co.za

# Admin credentials (for /api/admin routes)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SafiNjema@Admin2026
